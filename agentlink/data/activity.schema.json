{
 "$comment": "One entry of activity.json: a tool's words in the Agent Link panel's Activity tab (agentlink/activity.py).",
 "type": "object",
 "required": [
  "source",
  "date"
 ],
 "additionalProperties": false,
 "properties": {
  "did": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "result": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 }
}
