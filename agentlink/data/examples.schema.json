{
 "type": "object",
 "required": [
  "arguments",
  "source",
  "date"
 ],
 "additionalProperties": false,
 "properties": {
  "arguments": {
   "type": "object"
  },
  "fill": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "arg",
     "what"
    ],
    "additionalProperties": false,
    "properties": {
     "arg": {
      "type": "string",
      "minLength": 1
     },
     "what": {
      "type": "string",
      "minLength": 1
     },
     "keep": {
      "type": "boolean"
     },
     "unless": {
      "type": "string",
      "pattern": "^="
     }
    }
   }
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 }
}