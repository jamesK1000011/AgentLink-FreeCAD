{
 "dataVersion": "1.0.0",
 "licence": "LGPL-2.1-or-later",
 "about": "Agent Link's own tools that wrap one FreeCAD command, run by agentlink/runners.py. Descriptions, schemas and refusals are the tools' own, word for word.",
 "entries": {
  "pd_clone": {
   "group": "std_more",
   "description": "A new PartDesign body on another object's shape (PartDesign Clone): from (a body, a Part solid, anything with a shape), at [x,y,z] and axis, angle to place it, name. Its first feature (BaseFeature) follows the original; pd_ features go on top. Reply: body, from, volume.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string"
     },
     "at": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "axis": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "angle": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "from"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/std_more.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "type": "PartDesign::Body",
    "base": "Body"
   },
   "args": {
    "name": {
     "then": {
      "set": [
       "$o",
       "Label",
       {
        "call": "unique",
        "with": [
         {
          "or": [
           "$a.name",
           {
            "fmt": "{from.Label} clone"
           }
          ]
         },
         "$o"
        ]
       }
      ]
     }
    },
    "from": {
     "helper": "shaped",
     "with": [
      "$value",
      "$key"
     ],
     "prop": "BaseFeature"
    },
    "=place": {
     "then": {
      "if": [
       {
        "call": "placed",
        "with": [
         "$a"
        ]
       },
       {
        "set": [
         "$o",
         "Placement",
         {
          "call": "placement",
          "with": [
           "$a"
          ]
         }
        ]
       },
       null
      ]
     }
    }
   },
   "answer": {
    "first": [
     {
      "call": "done",
      "with": [
       "$tool",
       null
      ]
     }
    ],
    "fields": {
     "body": "$o.Label",
     "from": "$from.Label",
     "volume": {
      "if": [
       "$o.Shape.Solids",
       {
        "round": [
         "$o.Shape.Volume",
         3
        ]
       },
       null
      ]
     },
     "note": "A body built on the other's shape: its BaseFeature follows the original; add pd_ features on top (sketch_new on its planes or faces)."
    }
   }
  },
  "bim_level": {
   "group": "bim",
   "description": "A level (Building Storey) holding objects (labels), its floor at elevation mm; height: floor to floor. A container, not a lift: BIM components keep their own Z (build an upper storey on points with z); plain shapes put in it move up by the elevation. Then bim_building { levels }.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "objects": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "elevation": {
      "type": "number"
     },
     "height": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makeFloor",
    "call": [
     "$objects"
    ]
   },
   "args": {
    "objects": {
     "helper": "finds"
    },
    "elevation": {
     "helper": "num",
     "default": 0,
     "with": [
      "$value",
      "$key"
     ]
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       {
        "or": [
         "$a.name",
         "Level"
        ]
       }
      ]
     }
    },
    "=base": {
     "value": {
      "vec": [
       0,
       0,
       "$elevation"
      ]
     },
     "prop": "Placement.Base"
    },
    "height": {
     "prop": "Height",
     "has": true,
     "when": "truthy",
     "as": "float"
    }
   },
   "answer": {
    "via": "finish",
    "with": [
     "$o",
     "$tool",
     "$fields"
    ],
    "fields": {
     "elevation": "$elevation",
     "holds": "$objects[].Label"
    }
   }
  },
  "bim_pipe": {
   "group": "bim",
   "description": "A pipe swept along points [[x, y, z] …] mm: diameter (50), wall (thickness). Corners are sharp: bim_pipe_connector joins separate pipes with a bend. Answers diameter, length, box.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "points": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       }
      }
     },
     "diameter": {
      "type": "number"
     },
     "wall": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "points"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makePipe",
    "headless": "headless_call",
    "call": [
     "$points",
     "$diameter"
    ]
   },
   "rules": [
    {
     "check": "available",
     "of": "$maker",
     "after": "start",
     "code": "unavailable",
     "message": "This FreeCAD's BIM has no pipe."
    }
   ],
   "args": {
    "=pname": {
     "value": {
      "or": [
       "$a.name",
       "Pipe"
      ]
     }
    },
    "points": {
     "helper": "baseline",
     "with": [
      "$value",
      {
       "fmt": "{pname} path"
      }
     ]
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       "$pname"
      ]
     }
    },
    "diameter": {
     "helper": "pos",
     "with": [
      "$a",
      "$key",
      50
     ],
     "prop": "Diameter"
    },
    "wall": {
     "prop": "WallThickness"
    }
   },
   "answer": {
    "via": "finish",
    "with": [
     "$o",
     "$tool",
     "$fields"
    ],
    "fields": {
     "diameter": "$diameter",
     "length": {
      "round": [
       "$points.Shape.Length",
       1
      ]
     }
    }
   }
  },
  "bim_equipment": {
   "group": "bim",
   "description": "An object made BIM equipment (furniture, fixtures): object (a shape), ifc (FreeCAD's spaced type name: Furniture, Sanitary Terminal; a wrong one is refused with near names), model, url, watts.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "object": {
      "type": "string"
     },
     "ifc": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "watts": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "object"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makeEquipment",
    "headless": "headless_call",
    "call": [
     "$object"
    ]
   },
   "rules": [
    {
     "check": "available",
     "of": "$maker",
     "after": "start",
     "code": "unavailable",
     "message": "This FreeCAD's BIM has no equipment."
    }
   ],
   "args": {
    "object": {
     "helper": "find"
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       {
        "or": [
         "$a.name",
         {
          "fmt": "{object.Label} equipment"
         }
        ]
       }
      ]
     }
    },
    "model": {
     "prop": "Model"
    },
    "url": {
     "prop": "ProductURL"
    },
    "watts": {
     "prop": "EquipmentPower"
    },
    "ifc": {
     "then": {
      "call": "ifc_set",
      "with": [
       "$o",
       "$a.ifc"
      ]
     }
    }
   },
   "answer": {
    "via": "finish",
    "with": [
     "$o",
     "$tool",
     "$fields"
    ],
    "fields": {
     "from": "$object.Label"
    }
   }
  },
  "bim_list": {
   "group": "bim",
   "description": "The BIM objects: each one's label, ifc type, holds (what a level, building or site contains), in (the wall a window or door is set into). Changes nothing.",
   "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
   },
   "changes": false,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "read",
   "target": {
    "from": "$doc.Objects",
    "where": "is_bim",
    "each": {
     "object": "$o.Label",
     "ifc": {
      "call": "ifc_type",
      "with": [
       "$o"
      ]
     },
     "holds": {
      "when": "$o.Group?",
      "value": "$o.Group[].Label"
     },
     "in": {
      "when": "$o.Hosts?",
      "value": "$o.Hosts[].Label"
     }
    }
   },
   "answer": {
    "fields": {
     "objects": "$rows",
     "count": {
      "len": "$rows"
     }
    }
   }
  },
  "bim_remove_shape": {
   "group": "bim_gaps",
   "description": "Remove Shape from BIM: structures and walls whose shape is a plain box are rebuilt from their sizes; the new object carries the old one's internal name as its label. Anything else is left as it was.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "objects": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "objects"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim_gaps.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.removeShape",
    "headless": "headless_call",
    "call": [
     "$objects"
    ]
   },
   "args": {
    "objects": {
     "helper": "objs"
    },
    "=labels": {
     "value": "$objects[].Label"
    }
   },
   "answer": {
    "first": [
     {
      "call": "done",
      "with": [
       "$tool",
       null
      ]
     }
    ],
    "fields": {
     "turned": "$labels",
     "note": "Box-shaped structures and walls among them were rebuilt from their length, width and height and now carry their old internal name as label (object_list shows them); the rest were left as they were."
    }
   }
  },
  "bim_structural_system": {
   "group": "bim_gaps",
   "description": "One structure copied to every crossing of two axis sets (bim_grid's \"Grid X\", \"Grid Y\"), or along one. Its own position is added to each crossing: make it at [0, 0, 0]. structures: one per call. Answers system, copies (0: the axes do not cross).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "structures": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "axes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "structures",
     "axes"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim_gaps.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makeStructuralSystem",
    "headless": "headless_call",
    "call": [
     "$structures",
     "$axes"
    ]
   },
   "args": {
    "structures": {
     "helper": "objs",
     "with": [
      "$value",
      "$key"
     ]
    },
    "axes": {
     "helper": "objs",
     "with": [
      "$value",
      "$key"
     ]
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       "$a.name"
      ]
     }
    }
   },
   "answer": {
    "via": "done",
    "with": [
     "$tool",
     "$fields"
    ],
    "fields": {
     "system": "$o.Label",
     "copies": {
      "if": [
       {
        "do": [
         "$o.Shape",
         "isNull"
        ]
       },
       0,
       {
        "len": "$o.Shape.Solids"
       }
      ]
     },
     "...reading": {
      "call": "reading",
      "with": [
       "$o"
      ]
     }
    }
   },
   "rules": [
    {
     "check": "count",
     "of": "$structures",
     "min": 1,
     "max": 1,
     "after": "structures",
     "message": "structures: one structure per call (FreeCAD makes a separate system for each); call again for the next."
    },
    {
     "check": "count",
     "of": "$axes",
     "min": 1,
     "max": 2,
     "after": "axes",
     "message": "axes: one or two axis objects (bim_grid makes them: \"Grid X\", \"Grid Y\")."
    }
   ]
  },
  "bim_pipe_connector": {
   "group": "bim_gaps",
   "description": "A connector where the ends of two pipes meet (an elbow) or three (a tee): pipes (labels), radius of the bend mm (the pipe's diameter when left out). An error state on it means the ends do not meet.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "pipes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "radius": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "pipes"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim_gaps.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makePipeConnector",
    "headless": "headless_call",
    "call": [
     "$pipes",
     "$radius"
    ]
   },
   "rules": [
    {
     "check": "count",
     "of": "$pipes",
     "min": 2,
     "max": 3,
     "after": "pipes",
     "message": "pipes: two pipes (an elbow) or three (a tee) whose ends meet at one point; bim_pipe makes them."
    }
   ],
   "args": {
    "pipes": {
     "helper": "objs",
     "with": [
      "$value",
      "$key"
     ]
    },
    "radius": {
     "default": 0,
     "as": "float"
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       "$a.name"
      ]
     }
    }
   },
   "answer": {
    "via": "done",
    "with": [
     "$tool",
     "$fields"
    ],
    "fields": {
     "connector": "$o.Label",
     "pipes": "$pipes[].Label",
     "...reading": {
      "call": "reading",
      "with": [
       "$o"
      ]
     }
    }
   }
  },
  "meshobj_offset": {
   "group": "mesh",
   "description": "Move a mesh's surface along its point normals by distance mm (negative: inward); triangles the move turns over are collapsed, so a distance beyond the tightest inside radius damages the mesh: meshobj_info after. In place; copy: true makes a new mesh. Reply: offset, the mesh's reading.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "mesh": {
      "type": "string",
      "description": "The mesh's label; may be left out when there is one."
     },
     "distance": {
      "type": "number"
     },
     "copy": {
      "type": "boolean"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "distance"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/meshobj.py)",
   "date": "2026-11-14",
   "runner": "apply",
   "target": {
    "on": "mesh",
    "copy": "Mesh",
    "method": "offset",
    "call": [
     "$distance"
    ]
   },
   "args": {
    "mesh": {
     "helper": "mesh_of"
    },
    "distance": {
     "default": 0,
     "as": "float"
    }
   },
   "rules": [
    {
     "check": "nonzero",
     "of": "$distance",
     "after": "distance",
     "message": "distance: mm along the normals (negative: inward)."
    }
   ],
   "answer": {
    "via": "keep",
    "with": [
     "$o",
     "$m",
     "$tool",
     "$a",
     "$fields"
    ],
    "fields": {
     "offset": "$distance"
    }
   }
  },
  "draft_to_sketch": {
   "group": "draft",
   "description": "Draft shapes (or other flat shapes with edges) made into one new sketch on their plane: objects (all flat, in one plane); constrain: true (default) adds coincident, horizontal and vertical constraints where they hold, no dimensions; delete: true removes the originals. Reply: object, geometry, constraints (counts), length, box; sketch_state reads its degrees of freedom.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "objects": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "constrain": {
      "type": "boolean"
     },
     "delete": {
      "type": "boolean"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "objects"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/draft_more.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Draft.make_sketch",
    "call": [
     "$objects"
    ],
    "kw": {
     "autoconstraints": "$constrain",
     "delete": "$delete"
    }
   },
   "args": {
    "=active": {
     "value": {
      "call": "active"
     }
    },
    "objects": {
     "helper": "objs_of"
    },
    "constrain": {
     "default": true,
     "as": "bool"
    },
    "delete": {
     "as": "bool"
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       "$a.name",
       "Sketch"
      ]
     }
    }
   },
   "rules": [
    {
     "check": "given",
     "of": "$o",
     "after": "made",
     "code": "failed",
     "message": "Draft could not make a sketch of those: every object needs a shape, flat, and all in one plane (FreeCAD's report view names which failed). draft_modify op move or part_transform lays them in one plane first."
    }
   ],
   "answer": {
    "via": "finish",
    "with": [
     "$o",
     "$tool",
     "$fields"
    ],
    "fields": {
     "geometry": {
      "len": "$o.Geometry"
     },
     "constraints": {
      "len": "$o.Constraints"
     }
    }
   }
  }
 }
}
