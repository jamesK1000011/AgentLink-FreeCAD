{
 "dataVersion": "1.0.0",
 "licence": "LGPL-2.1-or-later",
 "about": "Agent Link's own tools that wrap one FreeCAD command, run by agentlink/runners.py. Descriptions, schemas and refusals are the tools' own, word for word.",
 "entries": {
  "pd_clone": {
   "group": "std_more",
   "description": "A new PartDesign body on another object's shape (PartDesign Clone): it follows the original; features go on top.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string"
     },
     "at": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "axis": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "angle": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "from"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/std_more.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "type": "PartDesign::Body",
    "base": "Body"
   },
   "args": {
    "name": {
     "then": {
      "set": [
       "$o",
       "Label",
       {
        "call": "unique",
        "with": [
         {
          "or": [
           "$a.name",
           {
            "fmt": "{from.Label} clone"
           }
          ]
         },
         "$o"
        ]
       }
      ]
     }
    },
    "from": {
     "helper": "shaped",
     "with": [
      "$value",
      "$key"
     ],
     "prop": "BaseFeature"
    },
    "=place": {
     "then": {
      "if": [
       {
        "call": "placed",
        "with": [
         "$a"
        ]
       },
       {
        "set": [
         "$o",
         "Placement",
         {
          "call": "placement",
          "with": [
           "$a"
          ]
         }
        ]
       },
       null
      ]
     }
    }
   },
   "answer": {
    "first": [
     {
      "call": "done",
      "with": [
       "$tool",
       null
      ]
     }
    ],
    "fields": {
     "body": "$o.Label",
     "from": "$from.Label",
     "volume": {
      "if": [
       "$o.Shape.Solids",
       {
        "round": [
         "$o.Shape.Volume",
         3
        ]
       },
       null
      ]
     },
     "note": "A body built on the other's shape: it follows the original; add features on top."
    }
   }
  },
  "bim_level": {
   "group": "bim",
   "description": "A level (building storey) holding objects, at elevation mm (height: floor to floor).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "objects": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "elevation": {
      "type": "number"
     },
     "height": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makeFloor",
    "call": [
     "$objects"
    ]
   },
   "args": {
    "objects": {
     "helper": "finds"
    },
    "elevation": {
     "helper": "num",
     "default": 0,
     "with": [
      "$value",
      "$key"
     ]
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       {
        "or": [
         "$a.name",
         "Level"
        ]
       }
      ]
     }
    },
    "=base": {
     "value": {
      "vec": [
       0,
       0,
       "$elevation"
      ]
     },
     "prop": "Placement.Base"
    },
    "height": {
     "prop": "Height",
     "has": true,
     "when": "truthy",
     "as": "float"
    }
   },
   "answer": {
    "via": "finish",
    "with": [
     "$o",
     "$tool",
     "$fields"
    ],
    "fields": {
     "elevation": "$elevation",
     "holds": "$objects[].Label"
    }
   }
  },
  "bim_pipe": {
   "group": "bim",
   "description": "A pipe along points: diameter, wall (thickness) mm.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "points": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       }
      }
     },
     "diameter": {
      "type": "number"
     },
     "wall": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "points"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makePipe",
    "headless": "headless_call",
    "call": [
     "$points",
     "$diameter"
    ]
   },
   "rules": [
    {
     "check": "available",
     "of": "$maker",
     "after": "start",
     "code": "unavailable",
     "message": "This FreeCAD's BIM has no pipe."
    }
   ],
   "args": {
    "=pname": {
     "value": {
      "or": [
       "$a.name",
       "Pipe"
      ]
     }
    },
    "points": {
     "helper": "baseline",
     "with": [
      "$value",
      {
       "fmt": "{pname} path"
      }
     ]
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       "$pname"
      ]
     }
    },
    "diameter": {
     "helper": "pos",
     "with": [
      "$a",
      "$key",
      50
     ],
     "prop": "Diameter"
    },
    "wall": {
     "prop": "WallThickness"
    }
   },
   "answer": {
    "via": "finish",
    "with": [
     "$o",
     "$tool",
     "$fields"
    ],
    "fields": {
     "diameter": "$diameter",
     "length": {
      "round": [
       "$points.Shape.Length",
       1
      ]
     }
    }
   }
  },
  "bim_equipment": {
   "group": "bim",
   "description": "An object made BIM equipment (furniture, fixtures, appliances): object, ifc (e.g. Furniture, Sanitary Terminal), model, url, watts.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "object": {
      "type": "string"
     },
     "ifc": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "watts": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "object"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makeEquipment",
    "headless": "headless_call",
    "call": [
     "$object"
    ]
   },
   "rules": [
    {
     "check": "available",
     "of": "$maker",
     "after": "start",
     "code": "unavailable",
     "message": "This FreeCAD's BIM has no equipment."
    }
   ],
   "args": {
    "object": {
     "helper": "find"
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       {
        "or": [
         "$a.name",
         {
          "fmt": "{object.Label} equipment"
         }
        ]
       }
      ]
     }
    },
    "model": {
     "prop": "Model"
    },
    "url": {
     "prop": "Url"
    },
    "watts": {
     "prop": "EquipmentPower"
    },
    "ifc": {
     "prop": "IfcType",
     "when": "truthy",
     "alone": true
    }
   },
   "answer": {
    "via": "finish",
    "with": [
     "$o",
     "$tool",
     "$fields"
    ],
    "fields": {
     "from": "$object.Label"
    }
   }
  },
  "bim_list": {
   "group": "bim",
   "description": "The BIM objects: IFC type, what each holds, which wall each opening is in. Changes nothing.",
   "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
   },
   "changes": false,
   "source": "Agent Link (was agentlink/families/bim.py)",
   "date": "2026-11-14",
   "runner": "read",
   "target": {
    "from": "$doc.Objects",
    "where": "is_bim",
    "each": {
     "object": "$o.Label",
     "ifc": {
      "call": "ifc_type",
      "with": [
       "$o"
      ]
     },
     "holds": {
      "when": "$o.Group?",
      "value": "$o.Group[].Label"
     },
     "in": {
      "when": "$o.Hosts?",
      "value": "$o.Hosts[].Label"
     }
    }
   },
   "answer": {
    "fields": {
     "objects": "$rows",
     "count": {
      "len": "$rows"
     }
    }
   }
  },
  "bim_remove_shape": {
   "group": "bim_gaps",
   "description": "Turn shape-only BIM objects into what they are (Remove Shape from BIM): a cubic shape becomes a structure with a profile and height.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "objects": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "objects"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim_gaps.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.removeShape",
    "headless": "headless_call",
    "call": [
     "$objects"
    ]
   },
   "args": {
    "objects": {
     "helper": "objs"
    }
   },
   "answer": {
    "first": [
     {
      "call": "done",
      "with": [
       "$tool",
       null
      ]
     }
    ],
    "fields": {
     "turned": "$objects[].Label",
     "note": "Shape-only BIM objects rebuilt from what they are (a box as a structure's profile and height) where Arch can read them."
    }
   }
  },
  "bim_structural_system": {
   "group": "bim_gaps",
   "description": "A structural system: structures repeated on the axes' crossings (a column on every grid node).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "structures": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "axes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "structures",
     "axes"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim_gaps.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makeStructuralSystem",
    "headless": "headless_call",
    "call": [
     "$structures",
     "$axes"
    ]
   },
   "args": {
    "structures": {
     "helper": "objs",
     "with": [
      "$value",
      "$key"
     ]
    },
    "axes": {
     "helper": "objs",
     "with": [
      "$value",
      "$key"
     ]
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       "$a.name"
      ]
     }
    }
   },
   "answer": {
    "via": "done",
    "with": [
     "$tool",
     "$fields"
    ],
    "fields": {
     "system": "$o.Label",
     "copies": {
      "if": [
       {
        "do": [
         "$o.Shape",
         "isNull"
        ]
       },
       0,
       {
        "len": "$o.Shape.Solids"
       }
      ]
     },
     "...reading": {
      "call": "reading",
      "with": [
       "$o"
      ]
     }
    }
   }
  },
  "bim_pipe_connector": {
   "group": "bim_gaps",
   "description": "A pipe connector where two pipes meet (an elbow) or three (a tee); radius of the bend.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "pipes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "radius": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "pipes"
    ],
    "additionalProperties": false
   },
   "changes": true,
   "source": "Agent Link (was agentlink/families/bim_gaps.py)",
   "date": "2026-11-14",
   "runner": "make",
   "target": {
    "maker": "Arch.makePipeConnector",
    "headless": "headless_call",
    "call": [
     "$pipes",
     "$radius"
    ]
   },
   "rules": [
    {
     "check": "count",
     "of": "$pipes",
     "min": 2,
     "max": 3,
     "after": "pipes",
     "message": "pipes: two (an elbow) or three (a tee) that meet."
    }
   ],
   "args": {
    "pipes": {
     "helper": "objs",
     "with": [
      "$value",
      "$key"
     ]
    },
    "radius": {
     "default": 0,
     "as": "float"
    },
    "name": {
     "then": {
      "call": "named",
      "with": [
       "$o",
       "$a.name"
      ]
     }
    }
   },
   "answer": {
    "via": "done",
    "with": [
     "$tool",
     "$fields"
    ],
    "fields": {
     "connector": "$o.Label",
     "pipes": "$pipes[].Label",
     "...reading": {
      "call": "reading",
      "with": [
       "$o"
      ]
     }
    }
   }
  }
 }
}
