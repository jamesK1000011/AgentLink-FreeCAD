     "arguments": {
      "object": "Pad",
      "values": {
       "Length": 25
      }
     }
    },
    {
     "tool": "session_state",
     "arguments": {}
    },
    {
     "tool": "object_freeze",
     "arguments": {
      "objects": [
       "Pad"
      ],
      "frozen": false
     }
    },
    {
     "tool": "recompute",
     "arguments": {
      "force": true
     }
    },
    {
     "tool": "session_state",
     "arguments": {}
    },
    {
     "tool": "object_set",
     "arguments": {
      "object": "Pad",
      "values": {
