{
 "name": "Core window tools (coredoc hardening)",
 "about": "Touches each window tool of the app, dev, unattended and notes groups once on the reset document (WindowTest: a 40 x 30 x 20 mm pad), with what a pass looks like in its reply. Proof is the reply or a headless read-back (object_get, session_state, selection { clear: false }), never a picture. Run live_run { script: \"reset\" } first, every time: a step run alone acts on whatever document is in front. Put this file in scripts/live (or give its path to live_run). Written from the sources, not run: where a title or a reply field differs on the Mac, the step's note says what to read instead.",
 "needs": [],
 "budget": "about 60 s; steps_render and the workbench switch are the slow ones. live_run { script, budget: 180 } runs it in one call; notRun names what is left otherwise.",
 "steps": [
  {
   "name": "doc_switch: the session is on WindowTest and brings it to the front",
   "calls": [
    {
     "tool": "doc_switch",
     "arguments": {}
    },
    {
     "tool": "doc_switch",
     "arguments": {
      "document": "WindowTest",
      "front": true
     }
    },
    {
     "tool": "doc_switch",
     "arguments": {
      "document": "NoSuchDocument"
     },
     "allow": [
      "not_found"
     ]
    }
   ],
   "expect": [
    {
     "call": 0,
     "path": "result.label",
     "equals": "WindowTest"
    },
    {
     "call": 0,
     "path": "result.open[*].name",
     "contains": "WindowTest"
    },
    {
     "call": 1,
     "path": "result.document",
     "equals": "WindowTest"
    },
    {
     "call": 1,
     "path": "result.front",
     "equals": true
    },
    {
     "call": 2,
     "path": "error.code",
     "equals": "not_found"
    },
    {
     "call": 2,
     "path": "error.message",
     "contains": "label (name)"
    }
   ],
   "pass": "reply 1 says Already on it with front true; the refusal lists the open documents as label (name)"
  },
  {
   "name": "workbench: list, activate by menu name, a wrong name refused with the list",
   "calls": [
    {
     "tool": "workbench",
     "arguments": {}
    },
    {
     "tool": "workbench",
     "arguments": {
      "activate": "Part Design"
     }
    },
    {
     "tool": "workbench",
     "arguments": {
      "activate": "No Such Bench"
     },
     "allow": [
      "not_found"
     ]
    },
    {
     "tool": "workbench",
     "arguments": {}
    }
   ],
   "expect": [
    {
     "call": 0,
     "path": "result.workbenches",
     "contains": "Part Design"
    },
    {
     "call": 1,
     "path": "result.active",
     "equals": "PartDesignWorkbench"
    },
    {
     "call": 1,
     "path": "result.was",
     "exists": true
    },
    {
     "call": 2,
     "path": "error.code",
     "equals": "not_found"
    },
    {
     "call": 3,
     "path": "result.active",
     "equals": "PartDesignWorkbench"
    }
   ]
  },
  {
   "name": "cmd_list finds view commands and marks refused ones",
   "calls": [
    {
     "tool": "cmd_list",
     "arguments": {
      "query": "Std_ViewFit"
     }
    },
    {
     "tool": "cmd_list",
     "arguments": {
      "query": "Std_DlgPreferences"
     }
    }
   ],
   "expect": [
    {
     "call": 0,
     "path": "result.count",
     "atLeast": 2
    },
    {
     "call": 0,
     "path": "result.commands[*].name",
     "contains": "Std_ViewFitAll"
    },
    {
     "call": 1,
     "path": "result.commands.0.refused",
     "exists": true
    },
    {
     "call": 0,
     "path": "result.workbench",
     "equals": "PartDesignWorkbench"
    }
   ]
  },
  {
   "name": "cmd_run runs an active command, refuses a dialog command and an inactive one",
   "calls": [
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_ViewIsometric"
     }
    },
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_ViewFitAll"
     }
    },
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_DlgPreferences"
     },
     "allow": [
      "refused"
     ]
    },
    {
     "tool": "selection",
     "arguments": {}
    },
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_ToggleVisibility"
     },
     "allow": [
      "invalid_state"
     ]
    },
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_NoSuchCommand"
     },
     "allow": [
      "not_found"
     ]
    }
   ],
   "expect": [
    {
     "call": 0,
     "path": "result.ran",
     "equals": "Std_ViewIsometric"
    },
    {
     "call": 0,
     "path": "result.wasActive",
     "equals": true
    },
    {
     "call": 1,
     "path": "result.document",
     "equals": "WindowTest"
    },
    {
     "call": 1,
     "path": "result.objectsAdded",
     "equals": 0
    },
    {
     "call": 2,
     "path": "error.code",
     "equals": "refused"
    },
    {
     "call": 3,
     "path": "result.cleared",
     "equals": true
    },
    {
     "call": 4,
     "path": "error.code",
     "equals": "invalid_state"
    },
    {
     "call": 4,
     "path": "error.message",
     "contains": "not active"
    },
    {
     "call": 5,
     "path": "error.code",
     "equals": "not_found"
    }
   ],
   "pass": "Std_ToggleVisibility is active only with a selection (FreeCAD 1.1 source: src/Gui/CommandView.cpp): with none selected the call is refused instead of doing nothing silently"
  },
  {
   "name": "selection sets what a command acts on; show brings it back",
   "calls": [
    {
     "tool": "selection",
     "arguments": {
      "objects": [
       "Body"
      ]
     }
    },
    {
     "tool": "selection",
     "arguments": {
      "clear": false
     }
    },
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_ToggleVisibility"
     }
    },
    {
     "tool": "object_get",
     "arguments": {
      "object": "Body",
      "filter": [
       "Visibility"
      ]
     }
    },
    {
     "tool": "show",
     "arguments": {
      "objects": [
       "Body",
       "Ghost part"
      ],
      "visible": true
     }
    },
    {
     "tool": "object_get",
     "arguments": {
      "object": "Body",
      "filter": [
       "Visibility"
      ]
     }
    },
    {
     "tool": "selection",
     "arguments": {
      "objects": [
       "Nope"
      ]
     },
     "allow": [
      "not_found"
     ]
    },
    {
     "tool": "selection",
     "arguments": {}
    }
   ],
   "expect": [
    {
     "call": 0,
     "path": "result.selected",
     "equals": [
      "Body"
     ]
    },
    {
     "call": 0,
     "path": "result.document",
     "equals": "WindowTest"
    },
    {
     "call": 1,
     "path": "result.selected",
     "equals": [
      "Body"
     ]
    },
    {
     "call": 2,
     "path": "result.ran",
     "equals": "Std_ToggleVisibility"
    },
    {
     "call": 3,
     "path": "result.properties.Visibility.value",
     "equals": false
    },
    {
     "call": 4,
     "path": "result.visible",
     "contains": "Body"
    },
    {
     "call": 4,
     "path": "result.unknown",
     "equals": [
      "Ghost part"
     ]
    },
    {
     "call": 5,
     "path": "result.properties.Visibility.value",
     "equals": true
    },
    {
     "call": 6,
     "path": "error.code",
     "equals": "not_found"
    },
    {
     "call": 7,
     "path": "result.selected",
     "equals": []
    }
   ]
  },
  {
   "name": "menu_list walks the View menu; menu_run presses Fit All; a submenu is refused",
   "calls": [
    {
     "tool": "menu_list",
     "arguments": {
      "menu": "View"
     }
    },
    {
     "tool": "menu_run",
     "arguments": {
      "path": [
       "View",
       "Standard Views",
       "Fit All"
      ]
     }
    },
    {
     "tool": "menu_run",
     "arguments": {
      "path": [
       "View",
       "Standard Views"
      ]
     },
     "allow": [
      "invalid_input"
     ]
    },
    {
     "tool": "menu_list",
     "arguments": {
      "menu": "No Such Menu"
     },
     "allow": [
      "not_found"
     ]
    }
   ],
   "expect": [
    {
     "call": 0,
     "path": "result.count",
     "atLeast": 10
    },
    {
     "call": 0,
     "path": "result.items[*].command",
     "contains": "Std_ViewFitAll"
    },
    {
     "call": 1,
     "path": "result.command",
     "equals": "Std_ViewFitAll"
    },
    {
     "call": 2,
     "path": "error.code",
     "equals": "invalid_input"
    },
    {
     "call": 3,
     "path": "error.code",
     "equals": "not_found"
    }
   ],
   "note": "Titles as FreeCAD 1.1 shows them (title case); the match ignores case. If call 1 is refused not_found, read the path of Std_ViewFitAll from call 0's items and use that."
  },
  {
   "name": "gui_input: a click on the pad's top face selects it, a click on empty space clears",
   "calls": [
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_ViewIsometric"
     }
    },
    {
     "tool": "cmd_run",
     "arguments": {
      "name": "Std_ViewFitAll"
     }
    },
    {
     "tool": "gui_input",
     "arguments": {
      "steps": [
       {
        "wait": 800
       },
       {
        "click": {
         "view_world": [
          10,
          5,
          20
         ]
        }
       },
       {
        "wait": 400
       }
      ],
      "inline": false
     }
    },
    {
     "tool": "selection",
     "arguments": {
      "clear": false
     }
    },
    {
     "tool": "gui_input",
     "arguments": {
      "steps": [
       {
        "click": {
         "view": [
          20,
          20
         ]
        }
       }
      ],
      "inline": false
     }
    },
    {
     "tool": "selection",
     "arguments": {
      "clear": false
     }
    }
   ],
   "expect": [
    {
     "call": 2,
     "path": "result.steps.1.selected.0",
     "contains": "Face"
    },
    {
     "call": 2,
     "path": "result.steps.1.menu",
     "exists": false
    },
    {
     "call": 3,
     "path": "result.detail.0.elements.0",
     "contains": "Face"
    },
    {
     "call": 4,
     "path": "result.steps.0.selected",
     "equals": []
    },
    {
     "call": 5,
     "path": "result.selected",
     "equals": []
    }
   ],
   "shot": "coredoc_click_select",
   "look": "the pad's top face highlighted as selected (only if a check failed)"
  },
  {
   "name": "gui_input: typing into a widget and the open report",
   "calls": [
    {
     "tool": "gui_input",
     "arguments": {
      "steps": [
       {
        "key": "Escape"
       },
       {
        "wait": 200
       }
      ],
      "inline": false
     }
    },
    {
     "tool": "gui_unstick",
     "arguments": {}
    },
    {
     "tool": "gui_unstick",
     "arguments": {
      "all": true
     }
    }
   ],
   "expect": [
    {
     "call": 0,
     "path": "result.steps.0",
     "exists": true
    },
    {
     "call": 0,
     "path": "result.open",
     "exists": false
    },
    {
     "call": 1,
     "path": "result.closed",
     "equals": []
    },
    {
     "call": 2,
     "path": "result.closed",
     "equals": []
    }
   ],
   "note": "Nothing is open, so gui_unstick closes nothing: closed []. If result.open exists after Escape, something held the window before the script: say what."
  },
  {
   "name": "object_freeze through the window's Std_ToggleFreeze",
